// Axo Business — core schema (Phase 1+2).
// Money is ALWAYS BigInt in the smallest currency unit (cents, or whole KES).
// Balances are derived from the ledger; the cached column is updated in the
// same transaction that posts the entries. Posted ledger rows are immutable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KybTier {
  micro
  registered
}

enum AccountStatus {
  active
  review
  suspended
}

enum Role {
  owner
  manager
  cashier
  accountant
}

enum LedgerAccountType {
  fiat_settlement
  axo_balance
  wallet_usdc
  wallet_usdt
  clearing // internal counter-account for external money
}

enum Direction {
  debit
  credit
}

enum TxnType {
  payment_in
  payout
  refund
  reversal
  bill
  credit_draw
  credit_repay
  p2p_transfer   // Axo-to-Axo customer send/receive
  cash_in        // funded from an external provider into an Axo wallet
  cash_out       // withdrawn from an Axo wallet to an external provider
}

enum TxnStatus {
  awaiting_approval // maker-checker: created, not yet approved (payouts)
  pending           // submitted to provider, not yet confirmed
  confirmed
  failed
  reversed
}

enum ReconStatus {
  matched
  unmatched   // we expected it, provider has not settled it
  mismatch    // amounts differ
  unexpected  // provider settled something not in our ledger
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  overdue
  cancelled
}

model Merchant {
  id            String        @id @default(uuid())
  legalName     String
  tradingName   String
  country       String        // ISO-3166 alpha-2
  currency      String        // ISO-4217
  axoId         String        @unique
  kybTier       KybTier       @default(micro)
  kybStatus     String        @default("pending")
  accountStatus AccountStatus @default(active)
  createdAt     DateTime      @default(now())

  users        User[]
  accounts     Account[]
  transactions Transaction[]
  invoices     Invoice[]
  auditLogs    AuditLog[]
}

model User {
  id          String   @id @default(uuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id])
  name        String
  email       String   @unique
  phone       String?
  role        Role     @default(owner)
  // argon2id hashes — never plaintext
  passwordHash String
  axoCodeHash  String?
  mfaEnabled   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([merchantId])
}

model Account {
  id           String            @id @default(uuid())
  merchantId   String
  merchant     Merchant          @relation(fields: [merchantId], references: [id])
  type         LedgerAccountType
  currency     String
  // cached balance; authoritative value is the SUM of ledger entries
  balanceMinor BigInt            @default(0)
  createdAt    DateTime          @default(now())

  entries LedgerEntry[]

  @@unique([merchantId, type, currency])
  @@index([merchantId])
}

// Immutable. Every money event posts >= 2 rows that net to zero.
model LedgerEntry {
  id          String      @id @default(uuid())
  accountId   String
  account     Account     @relation(fields: [accountId], references: [id])
  transactionId String
  transaction Transaction @relation(fields: [transactionId], references: [id])
  direction   Direction
  amountMinor BigInt
  currency    String
  postedAt    DateTime    @default(now())

  @@index([accountId])
  @@index([transactionId])
}

model Transaction {
  id             String      @id @default(uuid())
  merchantId     String
  merchant       Merchant    @relation(fields: [merchantId], references: [id])
  type           TxnType
  status         TxnStatus   @default(pending)
  amountMinor    BigInt
  currency       String
  provider       String      @default("axo")
  providerRef    String?     // set once the provider assigns it
  idempotencyKey String?
  customerRef    String?
  // for refunds/reversals: the original transaction they correct
  reversesId     String?
  // maker-checker (payouts): who created vs who approved
  makerId        String?
  checkerId      String?
  approvedAt     DateTime?
  createdAt      DateTime    @default(now())
  confirmedAt    DateTime?
  // settlement reconciliation link
  settlementId   String?

  entries        LedgerEntry[]
  invoicePayments InvoicePayment[]

  @@unique([provider, providerRef])
  @@index([merchantId])
  @@index([status])
}

model Invoice {
  id          String        @id @default(uuid())
  merchantId  String
  merchant    Merchant      @relation(fields: [merchantId], references: [id])
  number      String        // sequential per merchant
  customerName String
  customerPhone String?
  status      InvoiceStatus @default(draft)
  subtotalMinor BigInt
  taxRate     Float         @default(0)
  dueDate     DateTime?
  issuedAt    DateTime?
  createdAt   DateTime      @default(now())

  payments InvoicePayment[]

  @@unique([merchantId, number])
  @@index([merchantId])
}

model InvoicePayment {
  id            String      @id @default(uuid())
  invoiceId     String
  invoice       Invoice     @relation(fields: [invoiceId], references: [id])
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  amountMinor   BigInt
  method        String
  receivedAt    DateTime    @default(now())

  @@index([invoiceId])
}

// Idempotency: one row per key; stores the result so a retry returns it unchanged.
model IdempotencyKey {
  key          String   @id
  merchantId   String
  endpoint     String
  responseJson String   // serialized result to replay
  createdAt    DateTime @default(now())

  @@index([merchantId])
}

// De-dupe inbound provider webhooks by their event id.
model WebhookEvent {
  id         String   @id // provider event id
  provider   String
  processedAt DateTime @default(now())
}

enum BatchStatus {
  draft           // created, not approved
  approved        // maker-checker passed
  executing
  completed       // all items done (some may have failed)
  failed
}

enum BatchItemStatus {
  queued
  paid
  failed
}

// A bulk payment / payroll batch: many recipients paid in one approved run.
model Batch {
  id          String      @id @default(uuid())
  merchantId  String
  kind        String      // "payroll" | "supplier" | "bulk"
  currency    String
  status      BatchStatus @default(draft)
  makerId     String?
  checkerId   String?
  approvedAt  DateTime?
  createdAt   DateTime    @default(now())

  items BatchItem[]

  @@index([merchantId])
}

model BatchItem {
  id            String          @id @default(uuid())
  batchId       String
  batch         Batch           @relation(fields: [batchId], references: [id])
  recipient     String          // name/tag
  destination   String          // account/phone ref
  amountMinor   BigInt
  status        BatchItemStatus @default(queued)
  // the payout transaction created when this item is executed; also the
  // idempotency anchor so a retry never pays the same item twice
  transactionId String?
  error         String?

  @@index([batchId])
}

// A provider settlement record (one line of the settlement file / API).
// Reconciliation compares our expected amount (confirmed transactions) to the
// actual amount the provider settled, on providerRef.
model Settlement {
  id             String      @id @default(uuid())
  merchantId     String
  provider       String
  providerRef    String      // the provider's own reference for this payment
  actualMinor    BigInt      // what the provider says it settled
  feeMinor       BigInt      @default(0)
  currency       String
  reconStatus    ReconStatus @default(unmatched)
  matchedTxnId   String?     // our transaction it matched to
  importedAt     DateTime    @default(now())
  resolvedAt     DateTime?

  @@unique([provider, providerRef])
  @@index([merchantId])
  @@index([reconStatus])
}

// Per-merchant monotonic counters (invoice numbers, etc.). Incremented inside
// the same DB transaction that creates the numbered record, so numbers are
// gap-free and unique even under concurrency.
model Counter {
  merchantId String
  name       String // e.g. "invoice"
  value      Int    @default(0)

  @@id([merchantId, name])
}

// ============================================================================
// PHASE 6 — Customer (wallet-holder) + WhatsApp money layer.
// A Customer is an individual Axo wallet-holder, distinct from a Merchant's
// staff Users. Customers transact Axo-to-Axo over WhatsApp. Every balance is
// still derived from the double-entry ledger (CustomerLedgerEntry), never from
// any value the client sends.
// ============================================================================

enum CustomerStatus {
  unverified   // registered, phone not yet verified
  active
  review
  frozen       // risk hold; no debits until released
}

enum CustomerKycTier {
  basic        // phone-verified only: low limits
  verified     // ID-verified: higher limits
}

model Customer {
  id            String          @id @default(uuid())
  axoTag        String          @unique      // public handle, e.g. @amina
  displayName   String
  country       String          // ISO-3166 alpha-2
  currency      String          // ISO-4217, their wallet currency
  status        CustomerStatus  @default(unverified)
  kycTier       CustomerKycTier @default(basic)
  // Per-transaction PIN (the M-Pesa PIN). argon2id hash, never plaintext.
  pinHash       String?
  pinFailures   Int             @default(0)
  createdAt     DateTime        @default(now())

  wallet     CustomerAccount?
  waLink     WhatsAppLink?
  sentXfers     P2PTransfer[]   @relation("sender")
  receivedXfers P2PTransfer[]   @relation("recipient")
}

// One wallet account per customer. balanceMinor is the cached mirror of the
// CustomerLedgerEntry sum, updated in the same DB transaction that posts.
model CustomerAccount {
  id           String   @id @default(uuid())
  customerId   String   @unique
  customer     Customer @relation(fields: [customerId], references: [id])
  currency     String
  balanceMinor BigInt   @default(0)
  // reserved funds (e.g. a transfer in flight) that are not spendable
  reservedMinor BigInt  @default(0)
  createdAt    DateTime @default(now())

  entries CustomerLedgerEntry[]
}

// Immutable customer-side ledger. Mirrors LedgerEntry for the wallet layer.
// `transferId` anchors the entry to the movement that created it; `source` says
// which kind (a P2PTransfer or a CashTransfer), so one ledger table serves both
// the P2P and the cash-ramp flows under one debits==credits invariant. It is a
// plain reference (not a hard FK) precisely so it can point at either table.
model CustomerLedgerEntry {
  id          String          @id @default(uuid())
  accountId   String
  account     CustomerAccount @relation(fields: [accountId], references: [id])
  transferId  String
  source      String          @default("p2p") // "p2p" | "cash"
  direction   Direction
  amountMinor BigInt
  currency    String
  postedAt    DateTime        @default(now())

  @@index([accountId])
  @@index([transferId])
}

// Links a WhatsApp phone (WA id) to exactly one Customer. The mapping is only
// trusted AFTER OTP verification (verifiedAt set). WhatsApp identity alone is
// never sufficient to authorize a financial action.
model WhatsAppLink {
  id          String    @id @default(uuid())
  customerId  String    @unique
  customer    Customer  @relation(fields: [customerId], references: [id])
  waId        String    @unique   // WhatsApp phone number id (E.164 digits)
  phone       String                // display phone
  verifiedAt  DateTime?
  // step-up: a short-lived session token minted after a successful OTP; sensitive
  // actions require a live (unexpired) session, not just a linked number.
  sessionExpiresAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([waId])
}

// One-time passcodes for phone verification and step-up. The code is stored as
// an argon2id hash — never plaintext. Attempts are capped.
model OtpChallenge {
  id          String   @id @default(uuid())
  waId        String
  purpose     String   // "link" | "stepup"
  codeHash    String
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([waId])
}

enum P2PStatus {
  pending     // created, funds reserved on sender
  completed   // posted to the ledger, recipient credited
  failed
  reversed
}

// An Axo-to-Axo transfer between two customers. Server-authoritative: the
// amount, fee and both balances are computed and checked on the server.
model P2PTransfer {
  id             String    @id @default(uuid())
  senderId       String
  sender         Customer  @relation("sender", fields: [senderId], references: [id])
  recipientId    String
  recipient      Customer  @relation("recipient", fields: [recipientId], references: [id])
  amountMinor    BigInt
  feeMinor       BigInt    @default(0)
  currency       String
  status         P2PStatus @default(pending)
  note           String?
  idempotencyKey String?   @unique
  reversesId     String?   // if this reverses an earlier transfer
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  // Ledger entries reference this via CustomerLedgerEntry.transferId + source="p2p"
  // (a plain reference, not a hard FK — see that model).

  @@index([senderId])
  @@index([recipientId])
  @@index([status])
}

enum CashStatus {
  pending     // submitted to the external ramp, not yet confirmed
  confirmed   // webhook confirmed; wallet credited (in) / debited (out)
  failed
  reversed
}

enum CashOp {
  cash_in
  cash_out
}

// A cash-in / cash-out through an external ramp (M-Pesa, bank, agent). Bridges
// money into or out of an Axo wallet. Server-authoritative and webhook-confirmed:
// the wallet only moves when a verified provider webhook arrives. The customer
// ledger counter-leg is the clearing wallet, so the customer ledger still
// balances; reconciliation matches these against the provider settlement file.
model CashTransfer {
  id             String     @id @default(uuid())
  customerId     String
  op             CashOp
  amountMinor    BigInt
  currency       String
  // external source (cash_in) or destination (cash_out): e.g. an M-Pesa number
  externalRef    String
  provider       String
  providerRef    String?
  status         CashStatus @default(pending)
  idempotencyKey String?    @unique
  createdAt      DateTime   @default(now())
  confirmedAt    DateTime?

  @@unique([provider, providerRef])
  @@index([customerId])
  @@index([status])
}

// ============================================================================
// AGENT NETWORK (Phase 11) — Axo's OWN cash on-ramp/off-ramp. An agent takes
// physical cash from a customer and credits their Axo wallet (cash-in), or pays
// a customer cash and debits their wallet (cash-out). This is how Axo gets money
// in and out WITHOUT a telco — the same model M-Pesa used to bootstrap, but it
// belongs to Axo. The agent's own prepaid "float" is the liquidity; it settles
// INSTANTLY against that float, so there is no external provider or webhook.
// ============================================================================

enum AgentStatus {
  active
  suspended
}

model Agent {
  id             String      @id @default(uuid())
  code           String      @unique      // the agent/store code a customer quotes
  name           String
  country        String
  currency       String
  status         AgentStatus @default(active)
  // the agent's prepaid liquidity, in minor units. cash-in moves float→customer;
  // cash-out moves customer→float. An agent cannot cash-in beyond its float.
  floatMinor     BigInt      @default(0)
  // accrued, unpaid commission the agent has earned on volume.
  commissionMinor BigInt     @default(0)
  commissionBps  Int         @default(50) // 0.50% default earn rate
  createdAt      DateTime    @default(now())

  txns AgentTxn[]

  @@index([status])
}

enum AgentTxnKind {
  cash_in
  cash_out
  float_topup   // the agent buys more float (settled off-platform / by Axo)
}

model AgentTxn {
  id          String       @id @default(uuid())
  agentId     String
  agent       Agent        @relation(fields: [agentId], references: [id])
  kind        AgentTxnKind
  customerId  String?
  amountMinor BigInt
  commissionMinor BigInt   @default(0)
  currency    String
  idempotencyKey String?   @unique
  createdAt   DateTime     @default(now())

  @@index([agentId])
}

// Airtime top-ups and utility-bill payments an individual makes (M-Pesa "Buy
// airtime" / "Pay bill" for tokens). Debits the wallet and records the purchase;
// the external biller (telco, KPLC, water board) is a provider, confirmed like a
// cash-out. For electricity, the token is returned for the customer to enter.
enum BillerKind {
  airtime
  electricity
  water
  tv
  internet
  other
}

model BillerPurchase {
  id          String     @id @default(uuid())
  customerId  String
  kind        BillerKind
  target      String     // phone topped up, or utility account/meter number
  amountMinor BigInt
  currency    String
  token       String?    // e.g. an electricity token to enter on the meter
  status      String     @default("completed")
  idempotencyKey String? @unique
  createdAt   DateTime   @default(now())

  @@index([customerId])
}

enum ClaimStatus {
  unclaimed   // sender reserved funds; recipient hasn't claimed yet
  claimed     // recipient provisioned + credited
  refunded    // expired or recalled → returned to sender
}

// Send money to a phone number that has NO Axo wallet yet (M-Pesa
// "send to unregistered"). The sender's funds are RESERVED immediately; the
// recipient gets a WhatsApp claim link, and on claim their wallet is created and
// credited. If unclaimed by expiry (or recalled), it auto-refunds the sender.
model ClaimableTransfer {
  id             String      @id @default(uuid())
  code           String      @unique      // the claim code the recipient uses
  senderId       String
  recipientWaId  String                    // destination phone (digits)
  amountMinor    BigInt
  currency       String
  note           String?
  status         ClaimStatus @default(unclaimed)
  idempotencyKey String?     @unique
  expiresAt      DateTime
  createdAt      DateTime    @default(now())
  claimedAt      DateTime?

  @@index([recipientWaId])
  @@index([status])
}

// A money action the user has entered but NOT yet confirmed. The chat shows
// "Pay X to Y? Reply PIN" and holds the details here until they confirm with
// their PIN (or YES if no PIN is set). This is the M-Pesa "enter PIN to confirm"
// step — nothing moves until it is satisfied, so a typo or a stranger can't
// drain a wallet. One in-flight confirmation per number; it expires fast.
model PendingConfirm {
  id          String   @id @default(uuid())
  waId        String   @unique
  action      String   // "send" | "send_phone" | "pay_till" | "pay_bill"
  toTag       String?  // recipient @tag (send)
  toPhone     String?  // recipient phone (send_phone)
  number      String?  // till/paybill number
  account     String?  // paybill account
  amountMinor BigInt
  currency    String
  note        String?
  summary     String   // the human line shown to the user, e.g. "Pay KES 500 to @amina"
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([waId])
}

// A payment a brand-new WhatsApp number tried to make BEFORE having a wallet.
// Stored while they verify (first-contact onboarding), then executed. This is
// what lets "anyone with WhatsApp pay a business like M-Pesa" without prior signup.
model PendingPayIntent {
  id          String   @id @default(uuid())
  waId        String   @unique          // one in-flight intent per number
  kind        String                     // "till" | "paybill" | "push"
  number      String?                    // till/paybill number
  account     String?                    // paybill account line
  pushRef     String?                    // if resuming a push approval
  amountMinor BigInt
  currency    String
  createdAt   DateTime @default(now())

  @@index([waId])
}

enum PushStatus {
  pending     // sent to the customer, awaiting approval
  approved    // customer approved; payment posted
  declined
  expired
}

// A push-to-pay prompt (the Axo equivalent of an M-Pesa STK push). The merchant
// pushes it to a customer's Axo/WhatsApp; the customer approves, and ONLY then
// does payMerchant run. A request alone never moves money.
model PushPrompt {
  id          String     @id @default(uuid())
  ref         String     @unique   // CheckoutRequestID-style reference
  merchantId  String
  customerId  String?              // resolved from the WA/tag the merchant targeted
  targetWaId  String?              // who it was sent to
  amountMinor BigInt
  currency    String
  account     String?              // paybill account line, if any
  status      PushStatus @default(pending)
  idempotencyKey String?  @unique
  expiresAt   DateTime
  createdAt   DateTime   @default(now())
  resolvedAt  DateTime?

  @@index([merchantId])
  @@index([status])
}

// A payment number ISSUED BY AXO to a merchant — the Till / Paybill / Pay-ID
// that an Axo individual pays, exactly as an M-Pesa customer pays a business.
// Resolving a number here is how "pay till 832909" finds the right merchant.
enum PayNumberKind {
  till       // Buy Goods equivalent
  paybill    // account-based collections
  payid      // online / invoice
}

model PayNumber {
  id         String        @id @default(uuid())
  merchantId String
  kind       PayNumberKind
  number     String                      // the digits the customer quotes
  label      String?
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now())

  lines PayNumberLine[]

  @@unique([kind, number])               // a number is globally unique per kind
  @@index([merchantId])
}

// An account line under a Paybill (e.g. "RENT", "UNIT12"), like the account
// number an M-Pesa customer quotes. Optional for a Till.
model PayNumberLine {
  id          String    @id @default(uuid())
  payNumberId String
  payNumber   PayNumber @relation(fields: [payNumberId], references: [id])
  account     String                      // normalized code
  name        String?
  active      Boolean   @default(true)

  @@unique([payNumberId, account])
}

enum RiskCaseStatus {
  open
  under_review
  cleared       // analyst allowed it
  confirmed     // analyst confirmed the risk (stays blocked)
}

enum RiskCaseKind {
  transaction_review   // a movement scored >= review
  transaction_blocked  // a movement scored >= block
  manual_freeze        // an operator froze an account
  fraud_report         // a customer/merchant reported fraud
}

// A compliance/fraud case. Append-only history via AuditLog; the case row holds
// current state. Maker-checker: the operator who freezes cannot also release.
model RiskCase {
  id           String         @id @default(uuid())
  kind         RiskCaseKind
  status       RiskCaseStatus @default(open)
  // who/what this is about (a customer id, merchant id, or transfer id)
  subjectType  String         // "customer" | "merchant" | "transfer" | "cash"
  subjectId    String
  score        Int            @default(0)
  signalsJson  String?        // the risk signals that fired
  reason       String?
  openedBy     String?        // operator or "system"
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@index([status])
  @@index([subjectType, subjectId])
}

// Sanctions / fraud denylist entries. A real deployment syncs these from a
// screening provider; the value is stored normalized (lowercased, despaced).
model DenylistEntry {
  id        String   @id @default(uuid())
  value     String   @unique   // normalized tag / phone / account
  kind      String              // "tag" | "phone" | "account"
  reason    String?
  addedBy   String?
  createdAt DateTime @default(now())
}

// Append-only audit trail.
model AuditLog {
  id         String   @id @default(uuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  actorId    String?
  action     String
  target     String?
  beforeJson String?
  afterJson  String?
  at         DateTime @default(now())

  @@index([merchantId])
}
