# Copy to .env and fill in. Never commit real secrets.
APP_ENV=sandbox                 # sandbox | live
PORT=4000

# Postgres
DATABASE_URL=postgresql://axo:axo@localhost:5432/axo_business?schema=public

# Redis (idempotency store, locks, rate limits)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ARGON2_PEPPER=change-me-pepper

# Payment providers (per market) — sandbox works without these
# ACME_API_KEY=
# ACME_WEBHOOK_SECRET=

# WhatsApp Business Platform (Cloud API) — phase 6.
# VERIFY_TOKEN + APP_SECRET have dev defaults so the webhook verifies locally;
# set real values in live. PHONE_NUMBER_ID + TOKEN are required for OUTBOUND
# messages — without them the sender reports unavailable (it never fakes a send).
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_APP_SECRET=change-me-app-secret
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=

# Cash-in/out ramps (Phase 7) — the on-ramp/off-ramp bridging external money
# (M-Pesa, bank, agent) into/out of an Axo wallet.
# The sandbox ramp signs its own webhooks with this secret (dev/tests).
RAMP_SANDBOX_SECRET=sandbox-ramp-secret
# M-Pesa (Daraja) — all four required before the M-Pesa ramp is "available".
# Without them the adapter reports unavailable and is never used (no faked money).
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_WEBHOOK_SECRET=
# Crypto ramp (Phase 9) — business receives USDC/USDT and sends globally.
# Both required before the crypto rail is "available"; else it's refused, not faked.
# CRYPTO_API_KEY=
# CRYPTO_WEBHOOK_SECRET=
